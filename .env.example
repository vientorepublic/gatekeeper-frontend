PUBLIC_GATEKEEPER_API_BASE_URL=http://localhost:3000
PUBLIC_FLOWAUTH_SERVER=http://localhost:4000
PUBLIC_FLOWAUTH_CLIENT_ID=gatekeeper-frontend
PUBLIC_FLOWAUTH_REDIRECT_URI=http://localhost:5173/
PUBLIC_FLOWAUTH_SCOPES=openid,profile,email
# Browser flow uses a mocked secret (do not put real client secret in frontend)
PUBLIC_FLOWAUTH_CLIENT_SECRET_MOCK=mocked-browser-client-secret
